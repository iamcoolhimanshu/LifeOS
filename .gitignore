# ==========================================
# LifeOS Root GitIgnore
# Covers Frontend (Vite/React/Node), Backend (Spring Boot/Maven), and Chrome Extension
# ==========================================

# --- OS / IDE Files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/
.factorypath

# --- Node / Frontend (React + TypeScript + Vite) ---
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Java / Backend (Spring Boot + Maven) ---
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
crash-*
.mvn/wrapper/maven-wrapper.jar

# --- Environment & Credentials ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
application-local.properties
application-local.yml

# --- Extension Artifacts ---
*.crx

# --- Uploads & Temporary Data ---
*uploads/
**/uploads/
**/resouces/uploads/
*.pdf
*.docx
*.xlsx
*.pptx
*.jpg
*.jpeg
*.png
*.gif
# Keep specific assets if needed, but in general binary media files uploaded to the app should be ignored
!frontend/src/assets/**

# --- SQL Dumps ---
*.sql


